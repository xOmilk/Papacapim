@BASE_URL=https://api.papacapim.just.pro.br

### AUTH ###

### Register

POST {{BASE_URL}}/users
Content-Type: application/json

{
    "login": "luancoelho",
    "name": "Luan Coelho",
    "password": "12345",
    "password_confirmation": "12345"
}

### Login

POST {{BASE_URL}}/sessions
Content-Type: application/json

{
    "login": "daniboy",
    "password": "12345"
}

### listar seguidores
GET {{BASE_URL}}/users/daniboy/followers
x-session-token: 98533c22-1711-4795-ae86-52308859ee33


### Logout

DELETE {{BASE_URL}}/sessions/1

### Delete User

DELETE {{BASE_URL}}/users/me
